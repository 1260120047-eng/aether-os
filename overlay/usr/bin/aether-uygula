#!/bin/sh
# aether-uygula — ~/.config/aether/ayarlar içindeki ayarları masaüstüne uygular
AYAR="$HOME/.config/aether/ayarlar"
. /etc/aether/ayarlar; [ -f "$AYAR" ] && . "$AYAR"

if [ "$TEMA" = koyu ]; then
  GTK=Aether-Koyu; KOYU=1
else
  GTK=Aether; KOYU=0
fi

# GTK 3
mkdir -p "$HOME/.config/gtk-3.0" "$HOME/.config/xsettingsd"
cat > "$HOME/.config/gtk-3.0/settings.ini" <<EOF
[Settings]
gtk-theme-name=$GTK
gtk-icon-theme-name=Adwaita
gtk-cursor-theme-name=Adwaita
gtk-font-name=JetBrains Mono 10
gtk-application-prefer-dark-theme=$KOYU
gtk-enable-animations=$ANIMASYON
gtk-decoration-layout=menu:
EOF
cat > "$HOME/.config/xsettingsd/xsettingsd.conf" <<EOF
Net/ThemeName "$GTK"
Net/IconThemeName "Adwaita"
Gtk/CursorThemeName "Adwaita"
Gtk/FontName "JetBrains Mono 10"
Net/EnableEventSounds 0
EOF
pkill -HUP -x xsettingsd 2>/dev/null

# Pencere yöneticisi (Yörünge temayı ayarlar dosyasından okur)
pkill -HUP -x yorunge 2>/dev/null

# Terminal: aether-terminal temayı ayarlar dosyasından kendisi okur

# Duvar kağıdı ve klavye
[ -n "$DISPLAY" ] && {
  [ -f "$DUVAR" ] || DUVAR=/usr/share/aether/wallpapers/nebula.png
  feh --no-fehbg --bg-fill "$DUVAR" 2>/dev/null
  case "$KLAVYE" in
    trf) setxkbmap tr -variant f ;;
    us)  setxkbmap us ;;
    *)   setxkbmap tr ;;
  esac
  if [ "$1" = --oturum ] && [ -n "$COZUNURLUK" ]; then
    CIKIS=$(xrandr | awk '/ connected/{print $1; exit}')
    [ -n "$CIKIS" ] && xrandr --output "$CIKIS" --mode "$COZUNURLUK" 2>/dev/null
  fi
  # Pencere animasyonları (picom eklentisi)
  if command -v picom >/dev/null && [ "$ANIMASYON" = 1 ]; then
    pgrep -x picom >/dev/null || picom -b --config /etc/aether/picom.conf 2>/dev/null
  else
    pkill -x picom 2>/dev/null
  fi
}
exit 0
