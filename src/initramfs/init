#!/bin/busybox sh
# Aether canlı açılış (initramfs)
# ISO/USB'yi bulur, rootfs.sfs'i (varsayılan) RAM'e kopyalar, overlay kurup sisteme geçer.
/bin/busybox --install -s /bin
export PATH=/bin:/sbin
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mkdir -p /dev/pts /run
mount -t tmpfs -o mode=0755,size=90% run /run

sessiz=0; grep -qw quiet /proc/cmdline && sessiz=1
yaz() { [ $sessiz = 1 ] || echo "  [aether] $*"; }
kurtar() { echo; echo "  [aether] HATA: $*"; echo "  Kurtarma kabuğu açılıyor (çıkmak için: exit)"; setsid cttyhack sh; }

ETIKET=AETHER_1_0; TORAM=1
for a in $(cat /proc/cmdline); do
  case "$a" in
    aether.etiket=*) ETIKET="${a#*=}" ;;
    aether.toram=0) TORAM=0 ;;
    aether.kabuk) KABUK=1 ;;
  esac
done

yaz "Aether 1.0 Nebula başlıyor…"
# sessiz açılışta da kullanıcı bir şey görsün (konsol tty3'e yönlendirilmiş olabilir)
ekran() { [ -c /dev/tty1 ] && printf "\033[2J\033[H\n\n    A E T H E R   1.0 \"Nebula\"\n\n    %s\n" "$*" > /dev/tty1 2>/dev/null; }
ekran "Aether yukleniyor, lutfen bekle...  /  Loading, please wait..."
# Sürücüler: bulunan donanımın modüllerini yükle (coldplug) + gerekenler
for m in $(find /sys/devices -name modalias -exec cat {} + 2>/dev/null | sort -u); do modprobe -q -b "$m" 2>/dev/null; done
for m in loop squashfs overlay isofs cdrom sr_mod sd_mod usb_storage uas ahci ata_piix virtio_blk virtio_scsi virtio_pci nvme vfat nls_cp437 nls_utf8 nls_iso8859_1 ext4; do
  modprobe -q "$m" 2>/dev/null
done
mdev -s 2>/dev/null

# Ortamı bul (USB yavaş gelebilir: 20 sn dene)
mkdir -p /ortam /sfs /rw /yeni
bulundu=""
i=0
while [ $i -lt 40 ] && [ -z "$bulundu" ]; do
  mdev -s 2>/dev/null
  for d in $(blkid | grep "LABEL=\"$ETIKET\"" | cut -d: -f1) /dev/sr0 /dev/sr1; do
    [ -b "$d" ] || continue
    if mount -o ro "$d" /ortam 2>/dev/null; then
      if [ -f /ortam/aether/rootfs.sfs ]; then bulundu="$d"; break; fi
      umount /ortam
    fi
  done
  [ -n "$bulundu" ] && break
  i=$((i + 1)); sleep 0.5
done
[ -n "$bulundu" ] || kurtar "Aether ortamı (etiket $ETIKET) bulunamadı."
yaz "Ortam bulundu: $bulundu"

mkdir -p /run/aether
# Kurulumda listelenmesin diye kaynak diskin adını kaydet
kd=$(basename "$bulundu"); case "$kd" in nvme*|mmcblk*) kd="${kd%p[0-9]*}" ;; sr*) ;; *) kd=$(echo "$kd" | sed 's/[0-9]*$//') ;; esac
echo "$kd" > /run/aether/kaynak-disk

SFS=/ortam/aether/rootfs.sfs
if [ $TORAM = 1 ]; then
  bos=$(awk '/MemAvailable/{print $2}' /proc/meminfo)
  boy=$(( $(stat -c %s $SFS) / 1024 ))
  if [ "$bos" -gt $((boy * 2)) ]; then
    yaz "Sistem RAM'e yükleniyor…"; ekran "Sistem RAM'e kopyalaniyor (1 dakika surebilir)...  /  Copying to RAM..."
    cp $SFS /run/aether/rootfs.sfs && SFS=/run/aether/rootfs.sfs
  else
    yaz "RAM yetersiz, ortamdan çalışılacak."
  fi
fi
mount -t squashfs -o ro,loop "$SFS" /sfs || kurtar "rootfs.sfs bağlanamadı"
mount -t tmpfs -o mode=0755 tmpfs /rw
mkdir -p /rw/ust /rw/is
mount -t overlay overlay -o lowerdir=/sfs,upperdir=/rw/ust,workdir=/rw/is /yeni || kurtar "overlay kurulamadı"

# Bağlamaları yeni köke taşı (openrc /run'ı zaten bağlı görür ve dokunmaz)
mkdir -p /yeni/run
mount --move /run /yeni/run
mkdir -p /yeni/run/aether/ortam /yeni/run/aether/sfs /yeni/run/aether/rw
if [ "$SFS" = /run/aether/rootfs.sfs ]; then umount /ortam 2>/dev/null; else mount --move /ortam /yeni/run/aether/ortam; fi
mount --move /sfs /yeni/run/aether/sfs
mount --move /rw /yeni/run/aether/rw
# canlı sistemde fstab boş olsun
: > /yeni/etc/fstab

[ -n "$KABUK" ] && { echo "aether.kabuk: switch_root öncesi kabuk"; setsid cttyhack sh; }
mkdir -p /yeni/dev /yeni/proc /yeni/sys
mount --move /dev /yeni/dev
mount --move /proc /yeni/proc
mount --move /sys /yeni/sys
exec switch_root /yeni /sbin/init
kurtar "switch_root başarısız"
