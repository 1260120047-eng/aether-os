#!/bin/sh
# aether-menu — Yörünge sağ tık / Super menüsü. Dile göre Türkçe/İngilizce üretir.
# Biçim (sekmeyle ayrılmış):  B başlık · O etiket simge komut · - ayraç · M etiket simge (alt menü) · E (alt menü sonu) · P etiket simge (pencere listesi)
# Kullanım: aether-menu [yorunge] [guc]
[ "$1" = yorunge ] && shift
case "${LANG:-tr}" in en*) EN=1 ;; *) EN=0 ;; esac
t() { [ $EN = 1 ] && printf '%s' "$2" || printf '%s' "$1"; }
IC=/usr/share/icons
ad() { for p in "$IC/hicolor/48x48/apps/$1.png" "$IC/Adwaita/48x48/legacy/$1.png" "$IC/Adwaita/scalable/legacy/$1-symbolic.svg"; do [ -f "$p" ] && { echo "$p"; return; }; done; }
i() { printf 'O\t%s\t%s\t%s\n' "$1" "$2" "$3"; }
alt() { printf 'M\t%s\t%s\n' "$1" "$2"; }
son() { printf 'E\n'; }
ayrac() { printf -- '-\n'; }
CANLI=0; grep -q aether.canli /proc/cmdline 2>/dev/null && CANLI=1

guc() {
  i "$(t Kilitle Lock)" "$(ad aether-kilit)" "aether-guc kilitle"
  [ $CANLI = 1 ] || i "$(t "Oturumu Kapat" "Log Out")" "$(ad aether-cikis)" "aether-guc cikis"
  i "$(t "Yeniden Başlat" "Restart")" "$(ad aether-yeniden)" "aether-guc yeniden"
  i "$(t Kapat "Shut Down")" "$(ad aether-kapat)" "aether-guc kapat"
}

printf 'B\tA E T H E R\n'
if [ "$1" = guc ]; then guc; exit 0; fi

[ $CANLI = 1 ] && { i "$(t "Aether'i Diske Kur" "Install Aether")" "$(ad aether-kurulum)" aether-kurulum; ayrac; }
i "Terminal" "$(ad aether-terminal)" aether-terminal
i "$(t Dosyalar Files)" "$(ad aether-dosyalar)" pcmanfm
i "$(t "Metin Editörü" "Text Editor")" "$(ad aether-metin)" mousepad
i "Eclipse  ($(t "Web Tarayıcı" "Web Browser"))" "$(ad aether-eclipse)" eclipse-tarayici
ayrac
alt "$(t Uygulamalar Applications)" "$(ad aether-uygulamalar)"
  i "$(t "Resim Görüntüleyici" "Image Viewer")" "$(ad aether-resim)" ristretto
  i "$(t "Hesap Makinesi" "Calculator")" "$(ad aether-hesap)" galculator
  command -v audacious >/dev/null && i "$(t "Müzik Çalar" "Music Player")" "$(ad aether-muzik)" audacious
son
alt "$(t Oyunlar Games)" "$(ad aether-oyunlar)"
  i "$(t "Oyun Başlatıcı" "Game Launcher")" "$(ad aether-oyunlar)" aether-oyunlar
  i "$(t "Mayın Tarlası" "Minesweeper")" "$(ad aether-mayin)" aether-mayin
son
printf 'P\t%s\t%s\n' "$(t Pencereler Windows)" "$(ad aether-uygulamalar)"
ayrac
i "$(t Ayarlar Settings)" "$(ad aether-ayarlar)" aether-ayarlar
i "$(t "Ekran Görüntüsü" "Screenshot")" "$(ad aether-kamera)" aether-ekran-goruntusu
ayrac
guc
