#!/sbin/openrc-run
# Aether canlı oturum hazırlığı: "canli" kullanıcısı, otomatik giriş, dil
description="Aether canlı oturum"
depend() { before lightdm aether-splash-bitir; after localmount; }
start() {
	grep -q aether.canli /proc/cmdline || return 0
	ebegin "Aether canlı oturumu hazırlanıyor"
	DIL=tr; grep -q aether.dil=en /proc/cmdline && DIL=en
	if ! id canli >/dev/null 2>&1; then
		adduser -D -s /bin/bash -g "Aether Canlı" canli
		passwd -d canli >/dev/null 2>&1
		for g in wheel audio video input netdev plugdev cdrom; do addgroup canli $g 2>/dev/null; done
	fi
	mkdir -p /home/canli/.config/aether
	sed "s/^DIL=.*/DIL=$DIL/; s/^KARSILAMA=.*/KARSILAMA=0/; s/^KILIT_DK=.*/KILIT_DK=0/" /etc/aether/ayarlar > /home/canli/.config/aether/ayarlar
	chown -R canli:canli /home/canli
	[ "$DIL" = en ] && echo LANG=en_US.UTF-8 > /etc/aether/dil
	echo "permit nopass canli" > /etc/doas.d/canli.conf; chmod 600 /etc/doas.d/canli.conf
	mkdir -p /etc/lightdm/lightdm.conf.d
	printf '[Seat:*]\nautologin-user=canli\nautologin-session=aether\nautologin-user-timeout=0\n' > /etc/lightdm/lightdm.conf.d/50-canli.conf
	groupadd -f autologin 2>/dev/null; addgroup canli autologin 2>/dev/null
	eend 0
}
