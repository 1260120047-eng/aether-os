#!/sbin/openrc-run
# Aether açılış ekranı (Plymouth)
description="Aether açılış ekranı"
depend() { need udev; after udev-trigger udev-settle; before localmount; }
start() {
	grep -qw splash /proc/cmdline || return 0
	mkdir -p /run/plymouth
	/usr/sbin/plymouthd --mode=boot --attach-to-session --pid-file=/run/plymouth/pid 2>/dev/null || return 0
	/usr/bin/plymouth show-splash 2>/dev/null
	return 0
}
