#!/bin/sh
# aether-guc kilitle | cikis | yeniden | kapat
case "$1" in
  kilitle) exec aether-kilitle ;;
  cikis)   aether-ses kapanis; pkill -x yorunge ;;
  yeniden) aether-ses kapanis; systemctl reboot ;;
  kapat)   aether-ses kapanis; systemctl poweroff ;;
  *) echo "Kullanım: aether-guc kilitle|cikis|yeniden|kapat"; exit 1 ;;
esac
